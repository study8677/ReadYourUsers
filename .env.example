# GitHub Personal Access Token (fine-grained PAT recommended)
# Also supports GITHUB_TOKEN as fallback
READYOURUSERS_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# LLM Provider: "anthropic" or "openai" (default: anthropic)
LLM_PROVIDER=openai

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- OpenAI-compatible ---
OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/fanjingwen/ReadYourUsers
OPENROUTER_APP_TITLE=ReadYourUsers

# Model overrides (optional, auto-detected based on provider)
# ANALYSIS_MODEL=qwen/qwen3.6-plus:free
# AGGREGATION_MODEL=qwen/qwen3.6-plus:free
# OPENAI_FALLBACK_MODELS=openai/gpt-oss-120b:free,qwen/qwen3-next-80b-a3b-instruct:free,z-ai/glm-4.5-air:free
